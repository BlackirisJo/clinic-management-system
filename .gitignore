# Dependencies
node_modules/

# Build Output
dist/

# Environment & Keys
.env
.env.*
!.env.example

# Backups & Uploads
# مُرتكزة على الجذر عمداً: النمط غير المُرتكز (backups/) طابق أيضاً
# src/modules/backups/ وابتلع كود وحدة النسخ الاحتياطي من المستودع!
/uploads/
/backups/

# System Files
*.log
.DS_Store
.vscode/

# Local artifacts that carry live credentials
# مُرتكزة على الجذر عمداً وبأسماء دقيقة: /login.json يحتوي كلمة مرور
# دخول نصية، و/ds_check.mjs يحتوي سلسلة اتصال قاعدة بيانات فيها كلمة المرور.
# كلاهما ملف تشخيص محلي لا مصدر مشروع، وقواعد عامة (مثل *.json) كانت
# ستخفي ملفات المشروع المهمة.
/login.json
/ds_check.mjs

# Temporary scripts & SQL
tmp_*.js
tmp_*.sql
# Temporary AI/build/diagnostic reports
*-diff.txt
*diff*.txt
*status*.txt
*build*.txt
*i18n*.txt
*keys*.txt
*loaded*.txt
*inv-check.txt
