# ============================================
# Clinic Management System — Backend Environment
# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل
# ============================================

# --- Server ---
NODE_ENV=development
PORT=3000
# Origins المسموح لها بـ CORS (فاصلة بين القيم). اتركه فارغاً في التطوير.
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL >= 16) ---
# مطابقة لقيم docker-compose.yml الافتراضية
DB_HOST=localhost
DB_PORT=5433
DB_USER=clinic_admin
DB_PASSWORD=change_me_db_password
DB_NAME=clinic_db

# --- Authentication ---
# إلزامي: استخدم قيمة عشوائية طويلة في الإنتاج (مثلاً: openssl rand -hex 64)
JWT_SECRET=change_me_to_a_long_random_secret

# --- Seed Script (npm run seed) ---
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change_me_admin_password

# --- Backups ---
# إلزامي لتفعيل النسخ الاحتياطي المشفر. مفتاح سري طويل يُحفظ بأمان.
BACKUP_ENCRYPTION_KEY=change_me_backup_encryption_key
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ملاحظات:
# - النسخ الاحتياطي يتطلب توفر pg_dump/psql على الخادم
#   (صورة Docker تتضمن postgresql-client تلقائياً).
# - اختبارات التكامل تستخدم: INTEGRATION_BASE_URL, INTEGRATION_USERNAME, INTEGRATION_PASSWORD
#   (تُضبط في بيئة الاختبار فقط، راجع src/tests/clinical.integration.test.ts).
# - الواجهة الأمامية: انسخ frontend/.env.example إلى frontend/.env
#   واضبط VITE_API_URL عند فصل الواجهة عن الخادم.
